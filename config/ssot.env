# Monorepo paths
MONOREPO_BACKEND_DIR=CosyVoice
MONOREPO_FRONTEND_DIR=frontend
MONOREPO_BACKEND_PYTHON=.venv/bin/python
MONOREPO_BACKEND_ENTRYPOINT=tools/run_api_server.py
MONOREPO_BACKEND_REQUIREMENTS=requirements.macos.inference.txt

# Network
COSYVOICE_API_HOST=127.0.0.1
COSYVOICE_API_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
COSYVOICE_WEBUI_HOST=127.0.0.1
COSYVOICE_WEBUI_PORT=3008
COSYVOICE_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Backend runtime
TOKENIZERS_PARALLELISM=false
COSYVOICE_MODEL_DIR=pretrained_models/Fun-CosyVoice3-0.5B
COSYVOICE_API_OUTPUT_DIR=api_output
COSYVOICE_API_HISTORY_SIZE=100
COSYVOICE_API_AUDIT_SIZE=300
COSYVOICE_API_SUGGESTIONS_PER_FIELD=20
COSYVOICE_API_MAX_UPLOAD_BYTES=52428800
